# Same values as the Supabase project (Project Settings -> API, and
# Edge Functions -> Secrets). Do not commit the real .env file.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Must be byte-for-byte the same value as the Supabase secret
# EXCHANGE_CREDS_ENCRYPTION_KEY, or this service won't be able to decrypt
# credentials saved via connect-exchange (and vice versa).
EXCHANGE_CREDS_ENCRYPTION_KEY=

# Comma-separated list of origins allowed to call this service from a
# browser. Leave empty during initial testing (allows all origins).
ALLOWED_ORIGINS=https://www.thetradingdiary.com,https://thetradingdiary.com,https://the-trading-diary.lovable.app
PORT=8080
